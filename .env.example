# Local credentials for `pnpm admin:reset-usage` and `pnpm admin:announcements`.
# Copy to .env (gitignored). These values must match the separate Wrangler
# ADMIN_API_TOKEN secrets configured for each deployed environment.
ADMIN_API_TOKEN=your_production_admin_token
ADMIN_API_TOKEN_DEV=your_different_development_admin_token

# Required for --dev because the account workers.dev subdomain is deployment-specific.
WW_API_DEV_URL=https://ww-proxy-dev.your-subdomain.workers.dev

# Optional; production defaults to https://ww-proxy.leviwilkerson.com
# WW_API_PROD_URL=https://ww-proxy.leviwilkerson.com

# Optional loopback port for the announcement editor (default 4317).
# ANNOUNCEMENT_ADMIN_PORT=4317
